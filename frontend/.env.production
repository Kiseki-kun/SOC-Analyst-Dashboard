# Production build defaults. Vite loads this file for `vite build` only - the
# dev server and Docker Compose are unaffected, and a real environment variable
# still overrides anything set here.
#
# This is the deployed public API URL, not a secret. It lives here so a clean
# checkout builds correctly without any hosting-provider configuration; set
# VITE_API_BASE_URL in the host's build environment to point at a different
# backend. The /api/v1 suffix is required - the client appends paths to it.
VITE_API_BASE_URL=https://soc-analyst-dashboard.onrender.com/api/v1
