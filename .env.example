# =============================================================================
# SOC Analyst Dashboard - environment template
# =============================================================================
# Copy this file to `.env` and change every secret before running.
#
#   Windows PowerShell:  Copy-Item .env.example .env
#
# `.env` is git-ignored. Never commit real secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# Host port mapping
# -----------------------------------------------------------------------------
# Deliberately above 49152. This machine allocates Windows ephemeral ports from
# a low range (observed in use: 1025-8100), so binding 3000/5173/8000/5432 risks
# intermittent "address already in use" failures when an outbound connection
# transiently holds the port.
# Interface the published ports bind to. Loopback by default: Docker would
# otherwise publish to 0.0.0.0, exposing the database and API to your local
# network. Set to 0.0.0.0 only if you deliberately need access from another
# machine, and understand that the API has no TLS.
BIND_ADDRESS=127.0.0.1

FRONTEND_PORT=54173
BACKEND_PORT=58000
POSTGRES_PORT=55432

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_USER=soc
POSTGRES_PASSWORD=change_me_in_your_local_env_file
POSTGRES_DB=socdb
POSTGRES_HOST=postgres

# --- Managed / external PostgreSQL (Neon, RDS, Supabase, ...) ----------------
# Leave EMPTY for the Docker Compose stack: the URL is then assembled from the
# POSTGRES_* values above.
#
# Set it to a full SQLAlchemy URL to point the backend at a managed database
# instead. It takes priority over every POSTGRES_* value, and those are then
# ignored entirely - POSTGRES_PASSWORD is not required when this is set.
#
# Keep the `+psycopg` dialect suffix: that selects the installed driver.
# Managed providers require TLS, so keep `?sslmode=require`.
#
# The value below is a PLACEHOLDER with a fake host and fake credentials.
# Replace it with your own, and never commit the real one - `.env` is
# git-ignored precisely so this value stays out of the repository.
#
# DATABASE_URL_OVERRIDE=postgresql+psycopg://REPLACE_USER:REPLACE_PASSWORD@ep-example-host-000000.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_OVERRIDE=

# -----------------------------------------------------------------------------
# Backend security
# -----------------------------------------------------------------------------
# Generate a strong value, do not reuse the placeholder:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_generate_a_64_byte_urlsafe_random_string

# Shared secret the generator service uses to authenticate to the ingest API.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
INGEST_API_KEY=CHANGE_ME_generate_a_separate_random_string

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12

# Comma-separated list of allowed browser origins (no wildcards).
CORS_ORIGINS=http://localhost:54173,http://127.0.0.1:54173

# Set to "false" in any non-local deployment so refresh cookies require HTTPS.
COOKIE_SECURE=false

# SameSite policy for the refresh cookie: lax | strict | none.
# "lax" is correct when the browser loads the frontend and the API from the
# same site, which is the Docker Compose layout. Set "none" only when the
# frontend is hosted somewhere else - see the public deployment section below.
# "none" requires COOKIE_SECURE=true; the application refuses to start otherwise.
COOKIE_SAMESITE=lax

# =============================================================================
# Public deployment (API on a container host, frontend on static hosting)
# =============================================================================
# NOTHING BELOW IS A REAL VALUE, AND NO REAL SECRET BELONGS IN THIS FILE.
# This file is committed. Set the real values in your hosting provider's
# environment or secret store, never here and never in a tracked file.
#
# The defaults above are for local development and are wrong for a public
# deployment. These are the values that change:
#
#   ENVIRONMENT=production
#       Switches logging to JSON and disables /docs, /redoc and /openapi.json.
#
#   COOKIE_SECURE=true
#       Required over HTTPS, and it also enables the HSTS response header.
#
#   COOKIE_SAMESITE=none
#       Required when the frontend is on a different site from the API. With
#       "lax" the browser will not attach the refresh cookie to the cross-site
#       refresh request: login appears to work, then the session dies at the
#       first token refresh and on every page reload. Needs COOKIE_SECURE=true.
#
#   CORS_ORIGINS=https://<your-project>.pages.dev
#       The exact origin the browser sends, comma-separated if more than one.
#       NO TRAILING SLASH. A browser sends "https://x.pages.dev"; a configured
#       value of "https://x.pages.dev/" never matches it, and every request
#       fails CORS with nothing in the logs to explain why.
#
#   DATABASE_URL_OVERRIDE=<your managed PostgreSQL URL>
#       See the section above. Use the direct (non-pooled) endpoint.
#
#   SECRET_KEY=<64+ random characters>
#   INGEST_API_KEY=<48+ random characters>
#       Generate fresh values for the deployment - do not reuse the local ones:
#         python -c "import secrets; print(secrets.token_urlsafe(64))"
#
#   SEED_DEMO_USERS=true
#   DEMO_ADMIN_PASSWORD / DEMO_ANALYST_PASSWORD /
#   DEMO_RESPONDER_PASSWORD / DEMO_VIEWER_PASSWORD
#       Only if you want the demo accounts on the public instance. The
#       passwords documented in this file are public, so the application
#       refuses to start with ENVIRONMENT=production, SEED_DEMO_USERS=true and
#       any of them unchanged. Set four new values in the provider's secret
#       store. They become publicly usable logins by design - do not reuse a
#       password from anywhere else.
#
# The frontend is built separately and reads a different variable:
#
#   VITE_API_BASE_URL=https://<your-api-host>/api/v1
#       This belongs in the FRONTEND hosting provider's build environment, not
#       in this file and not in the API's environment. Vite inlines VITE_*
#       variables at build time, so it must be set before the build runs; if it
#       is missing the deployed site falls back to localhost and every request
#       fails. Include the /api/v1 suffix.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# -----------------------------------------------------------------------------
# Demo bootstrap accounts
# -----------------------------------------------------------------------------
# Created once on first startup by scripts/seed.py, only when the users table is
# empty. Change these passwords. They exist so the project is demonstrable.
#
# These four passwords are committed to the repository, so they are public.
# The application refuses to start if ENVIRONMENT=production and
# SEED_DEMO_USERS=true while any of them is still set to the value below.
SEED_DEMO_USERS=true
DEMO_ADMIN_EMAIL=admin@soc.example.com
DEMO_ADMIN_PASSWORD=ChangeMe_Admin_123!
DEMO_ANALYST_EMAIL=analyst@soc.example.com
DEMO_ANALYST_PASSWORD=ChangeMe_Analyst_123!
DEMO_RESPONDER_EMAIL=responder@soc.example.com
DEMO_RESPONDER_PASSWORD=ChangeMe_Responder_123!
DEMO_VIEWER_EMAIL=viewer@soc.example.com
DEMO_VIEWER_PASSWORD=ChangeMe_Viewer_123!

# -----------------------------------------------------------------------------
# Synthetic telemetry generator
# -----------------------------------------------------------------------------
GENERATOR_ENABLED=true
# Baseline benign events per second. Kept low so the database does not grow
# without bound during a long demo.
GENERATOR_EVENTS_PER_SECOND=2.0
# Seconds between pushes to the ingest endpoint.
GENERATOR_BATCH_INTERVAL_SECONDS=5
# Probability that any given tick starts an attack scenario.
GENERATOR_ATTACK_PROBABILITY=0.12
# Fixed seed makes a demo reproducible. Leave empty for varied output.
GENERATOR_SEED=
GENERATOR_BACKEND_URL=http://backend:8000

# -----------------------------------------------------------------------------
# Retention
# -----------------------------------------------------------------------------
# Events older than this are pruned by the maintenance task, protecting the
# 12 GB-class disks this project targets.
EVENT_RETENTION_DAYS=7
