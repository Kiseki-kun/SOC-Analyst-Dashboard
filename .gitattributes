# Normalize all text files to LF in the repository.
# Critical for Windows + Docker: a shell script checked out with CRLF fails
# inside a Linux container with a misleading "no such file or directory".
* text=auto eol=lf

# Files that must ALWAYS be LF, regardless of platform.
*.sh            text eol=lf
*.py            text eol=lf
*.ts            text eol=lf
*.tsx           text eol=lf
*.js            text eol=lf
*.jsx           text eol=lf
*.json          text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.sql           text eol=lf
*.md            text eol=lf
*.env*          text eol=lf
Dockerfile      text eol=lf
*.Dockerfile    text eol=lf
.gitignore      text eol=lf
.dockerignore   text eol=lf

# Windows-only helper scripts keep CRLF.
*.ps1           text eol=crlf
*.bat           text eol=crlf
*.cmd           text eol=crlf

# Binary files: never touch.
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.ico           binary
*.woff          binary
*.woff2         binary
*.pdf           binary
